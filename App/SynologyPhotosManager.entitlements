<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox: required for eventual /Applications distribution (per plan). -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Outbound HTTPS to the NAS. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Read/write files the user explicitly picks (upload sources, download folder). -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- NOTE: app-scope bookmarks were declared here for a resumable transfer
	     queue that never got built — there is no `bookmarkData` call anywhere in
	     the app — so the entitlement is gone. An unused capability is one more
	     thing a user reading `codesign -d --entitlements` has to take on trust.
	     Put it back the day the code actually needs it. -->
</dict>
</plist>
